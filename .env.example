# Google Gemini AI API Key (for smart AI message composer & drafting)
GEMINI_API_KEY=your_gemini_api_key_here

# Microsoft 365 / Graph API Configuration (for University / School / Organization accounts)
MS_CLIENT_ID=04b07795-8ddb-461a-bbee-02f9e1bf7b46
MS_AUTHORITY=https://login.microsoftonline.com/organizations

# SMTP Configuration (Optional fallback for Gmail or custom SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
DEFAULT_FROM_NAME=Academic / Admin Department
DEFAULT_REPLY_TO=contact@institution.edu

# WhatsApp Defaults
DEFAULT_COUNTRY_CODE=92

